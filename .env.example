# Infraestrutura / banco
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_PRISMA_URL=
POSTGRES_DIRECT_URL=

# Olist agora deve ficar na tabela aplicativo.
# Estes fallbacks temporarios mantem o app funcionando ate cadastrar os campos no banco:
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_REDIRECT_URI=
OLIST_API_BASE_URL=
OLIST_OAUTH_URL=
OLIST_OAUTH_AUTHORIZE_URL=

# OpenAI Images API
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_ANALYSIS_PROVIDER=openai
AI_PRIMARY_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gpt-5.4-mini
AI_MIN_CONFIDENCE=0.7
AI_MIN_SEGMENTATION_CONFIDENCE=0.7
AI_MIN_TEXTILE_PATTERN_CONFIDENCE=0.7
AI_PRIMARY_INVALID_RESPONSE_ATTEMPTS=1
AI_PRIMARY_IMAGE_DETAIL=low
AI_FALLBACK_IMAGE_DETAIL=high
AI_MAX_OUTPUT_TOKENS=700
AI_BATCH_ENABLED=false
AI_BATCH_MAX_JOBS=500
OPENAI_IMAGE_ANALYSIS_TIMEOUT_MS=60000
ESTAMPA_PREVIEW_ALLOWED_HOSTS=storage.googleapis.com
ESTAMPA_PREVIEW_TIMEOUT_MS=15000
ESTAMPA_PREVIEW_MAX_BYTES=10485760

# Google Cloud Storage
GOOGLE_CLOUD_STORAGE_BUCKET=forro-de-mesa-retangular
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=

# Worker de estampas (processo separado do Next.js)
ESTAMPA_AI_PROCESSOR_MODE=
ESTAMPA_ALLOW_STUB_COMPLETION=false
ESTAMPA_WORKER_ID=
ESTAMPA_WORKER_CONCURRENCY=2
ESTAMPA_WORKER_POLL_MS=5000
ESTAMPA_WORKER_LOCK_TIMEOUT_MS=900000
ESTAMPA_DETECTOR_INTERVAL_MS=60000
ESTAMPA_RETRY_BASE_DELAY_MS=10000
ESTAMPA_RETRY_MAX_DELAY_MS=300000
