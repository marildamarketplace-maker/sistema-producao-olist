generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Aplicativo {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                      String
  olistClientId             String?                    @map("olist_client_id")
  olistClientSecret         String?                    @map("olist_client_secret")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  baixasEstoqueOlist        BaixaEstoqueOlist[]
  categoriasOlist           CategoriaOlist[]
  configuracoesSistema      ConfiguracaoSistema[]
  controlesBuscaOlist       ControleBuscaOlist[]
  fornecedores              Fornecedor[]
  integracoesOlistToken     IntegracaoOlistToken[]
  itensBaixaEstoqueOlist    ItemBaixaEstoqueOlist[]
  itensSolicitacaoDevolucao ItemSolicitacaoDevolucao[]
  itensSolicitacaoProducao  ItemSolicitacaoProducao[]
  midias                    Midia[]
  movimentacoesEstoque      MovimentacaoEstoque[]
  pedidosOlistProcessados   PedidoOlistProcessado[]
  produtos                  Produto[]
  produtosFornecedor        ProdutoFornecedor[]
  solicitacoesDevolucao     SolicitacaoDevolucao[]
  solicitacoesProducao      SolicitacaoProducao[]
  usuarios                  Usuario[]

  @@map("aplicativo")
}

model CategoriaOlist {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aplicativoId  String     @map("aplicativo_id") @db.Uuid
  olistId       String     @map("olist_id")
  nome          String
  caminho       String
  parentOlistId String?    @map("parent_olist_id")
  nivel         Int        @default(0)
  ativo         Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  aplicativo    Aplicativo @relation(fields: [aplicativoId], references: [id], onDelete: Cascade)
  midias        Midia[]

  @@unique([aplicativoId, olistId], map: "uq_categoria_olist_aplicativo_olist")
  @@index([aplicativoId, caminho], map: "idx_categoria_olist_aplicativo_caminho")
  @@map("categorias_olist")
}

model Midia {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aplicativoId String          @map("aplicativo_id") @db.Uuid
  categoriaId  String?         @map("categoria_id") @db.Uuid
  tipo         String
  titulo       String?
  arquivoUrl   String          @map("arquivo_url")
  storagePath  String          @map("storage_path")
  contentType  String          @map("content_type")
  largura      Int?
  altura       Int?
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  aplicativo   Aplicativo      @relation(fields: [aplicativoId], references: [id], onDelete: Cascade)
  categoria    CategoriaOlist? @relation(fields: [categoriaId], references: [id])

  @@index([aplicativoId, tipo], map: "idx_midia_aplicativo_tipo")
  @@index([categoriaId], map: "idx_midia_categoria")
  @@map("midias")
}

model Usuario {
  id                               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aplicativoId                     String       @map("aplicativo_id") @db.Uuid
  nome                             String
  email                            String
  ativo                            Boolean      @default(true)
  podeVisualizarEstoque            Boolean      @default(false) @map("pode_visualizar_estoque")
  podeEditarEstoque                Boolean      @default(false) @map("pode_editar_estoque")
  podeVisualizarTiposProduto       Boolean      @default(false) @map("pode_visualizar_tipos_produto")
  podeEditarTiposProduto           Boolean      @default(false) @map("pode_editar_tipos_produto")
  podeVisualizarTamanhos           Boolean      @default(false) @map("pode_visualizar_tamanhos")
  podeEditarTamanhos               Boolean      @default(false) @map("pode_editar_tamanhos")
  podeVisualizarEstampas           Boolean      @default(false) @map("pode_visualizar_estampas")
  podeEditarEstampas               Boolean      @default(false) @map("pode_editar_estampas")
  podeVisualizarVariantes          Boolean      @default(false) @map("pode_visualizar_variantes")
  podeEditarVariantes              Boolean      @default(false) @map("pode_editar_variantes")
  podeVisualizarBaixa              Boolean      @default(false) @map("pode_visualizar_baixa")
  podeSolicitarBaixa               Boolean      @default(false) @map("pode_solicitar_baixa")
  podeVisualizarDevolucao          Boolean      @default(false) @map("pode_visualizar_devolucao")
  podeSolicitarDevolucao           Boolean      @default(false) @map("pode_solicitar_devolucao")
  podeSolicitarProducao            Boolean      @default(false) @map("pode_solicitar_producao")
  podeVisualizarProducao           Boolean      @default(false) @map("pode_visualizar_producao")
  podeConfirmarProducao            Boolean      @default(false) @map("pode_confirmar_producao")
  podeVisualizarConfiguracao       Boolean      @default(false) @map("pode_visualizar_configuracao")
  podeEditarConfiguracao           Boolean      @default(false) @map("pode_editar_configuracao")
  createdAt                        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  podeVisualizarCategoriasMidia    Boolean      @default(false) @map("pode_visualizar_categorias_midia")
  podeVisualizarDashboard          Boolean      @default(false) @map("pode_visualizar_dashboard")
  podeVisualizarFornecedores       Boolean      @default(false) @map("pode_visualizar_fornecedores")
  podeVisualizarProdutosFornecedor Boolean      @default(false) @map("pode_visualizar_produtos_fornecedor")
  podeCriarOlistPedido             Boolean      @default(false) @map("pode_criar_olist_pedido")
  podeVisualizarOlistContatos      Boolean      @default(false) @map("pode_visualizar_olist_contatos")
  podeVisualizarOlistPedidos       Boolean      @default(false) @map("pode_visualizar_olist_pedidos")
  podeVisualizarOlistProdutos      Boolean      @default(false) @map("pode_visualizar_olist_produtos")
  podeVisualizarOlistVendedores    Boolean      @default(false) @map("pode_visualizar_olist_vendedores")
  vendedorOlistId                  Int?         @map("vendedor_olist_id")
  fornecedoresComoVendedor         Fornecedor[]
  aplicativo                       Aplicativo   @relation(fields: [aplicativoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([aplicativoId, email], map: "uq_usuario_aplicativo_email")
  @@index([aplicativoId], map: "idx_usuario_aplicativo_id")
  @@map("usuario")
}

model Fornecedor {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome              String
  endereco          String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  aplicativoId      String?             @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  vendedorOlistId   String?             @map("vendedor_olist_id") @db.Uuid
  meuClienteOlistId Int?                @map("meu_cliente_olist_id")
  aplicativo        Aplicativo?         @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendedor          Usuario?            @relation(fields: [vendedorOlistId], references: [id], onUpdate: NoAction)
  produtos          ProdutoFornecedor[]
  pedidosSolicitacao PedidoFornecedorSolicitacao[]

  @@index([aplicativoId], map: "idx_fornecedores_aplicativo_id")
  @@index([vendedorOlistId], map: "idx_fornecedores_vendedor_olist_id")
  @@index([nome], map: "idx_fornecedores_nome")
  @@map("fornecedores")
}

model ProdutoFornecedor {
  id                        String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fornecedorId              String                          @map("fornecedor_id") @db.Uuid
  nome                      String
  descricao                 String?
  referencia                String?
  precoUnitarioMetro        Decimal                         @map("preco_unitario_metro") @db.Decimal(10, 2)
  createdAt                 DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                        @default(now()) @map("updated_at") @db.Timestamptz(6)
  aplicativoId              String?                         @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  alturaEmbalagemMetro      Decimal?                        @map("altura_embalagem_metro") @db.Decimal(10, 2)
  comprimentoEmbalagemMetro Decimal?                        @map("comprimento_embalagem_metro") @db.Decimal(10, 2)
  larguraEmbalagemMetro     Decimal?                        @map("largura_embalagem_metro") @db.Decimal(10, 2)
  pesoBrutoMetro            Decimal?                        @map("peso_bruto_metro") @db.Decimal(10, 3)
  pesoLiquidoMetro          Decimal?                        @map("peso_liquido_metro") @db.Decimal(10, 3)
  produtosOlist             ProdutoOlistProdutoFornecedor[]
  aplicativo                Aplicativo?                     @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fornecedor                Fornecedor                      @relation(fields: [fornecedorId], references: [id], onUpdate: NoAction)
  tamanhos                  TamanhoProdutoFornecedor[]
  tiposProduto              TipoProdutoProdutoFornecedor[]

  @@index([aplicativoId], map: "idx_produtos_fornecedor_aplicativo_id")
  @@index([fornecedorId], map: "idx_produtos_fornecedor_fornecedor_id")
  @@index([nome], map: "idx_produtos_fornecedor_nome")
  @@map("produtos_fornecedor")
}

model Produto {
  id                     String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                    String                         @unique
  imagemUrl              String?                        @map("imagem_url")
  metaEstoque            Int?                           @map("meta_estoque")
  ativo                  Boolean                        @default(true)
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  minimoEstoque          Int?                           @map("minimo_estoque")
  aplicativoId           String?                        @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  idCadastroOlist        String?                        @map("id_cadastro_olist")
  produtosOlist          ProdutoOlist[]
  produtoFornecedorOlist ProdutoOlistProdutoFornecedor?
  aplicativo             Aplicativo?                    @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_produtos_aplicativo_id")
  @@map("produtos")
}

model ConfiguracaoSistema {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chave        String      @unique
  valor        Decimal     @db.Decimal
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aplicativoId String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo   Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_configuracoes_sistema_aplicativo_id")
  @@map("configuracoes_sistema")
}

model SolicitacaoProducao {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataEntrega        DateTime    @map("data_entrega") @db.Date
  turnoId            String?     @map("turno_id") @db.Uuid
  filtroDataBase     String?     @map("filtro_data_base")
  periodoInicio      DateTime?   @map("periodo_inicio") @db.Timestamptz(6)
  periodoFim         DateTime?   @map("periodo_fim") @db.Timestamptz(6)
  status             String      @default("pendente")
  observacaoGeral    String?     @map("observacao_geral")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  prioridadeProducao Boolean     @default(false) @map("prioridade_producao")
  aplicativoId       String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo         Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidosFornecedor  PedidoFornecedorSolicitacao[]

  @@index([aplicativoId], map: "idx_solicitacoes_producao_aplicativo_id")
  @@map("solicitacoes_producao")
}

model PedidoFornecedorSolicitacao {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoOlistId String              @map("pedido_olist_id")
  fornecedorId  String              @map("fornecedor_id") @db.Uuid
  solicitacaoId String              @map("solicitacao_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  fornecedor    Fornecedor          @relation(fields: [fornecedorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  solicitacao   SolicitacaoProducao @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([pedidoOlistId, fornecedorId], map: "uq_pedido_fornecedor_solicitacao_pedido_fornecedor")
  @@index([fornecedorId], map: "idx_pedido_fornecedor_solicitacao_fornecedor_id")
  @@index([solicitacaoId], map: "idx_pedido_fornecedor_solicitacao_solicitacao_id")
  @@map("pedido_fornecedor_solicitacao")
}

model ItemSolicitacaoProducao {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitacaoId        String      @map("solicitacao_id") @db.Uuid
  produtoId            String      @map("produto_id") @db.Uuid
  sku                  String
  imagemUrl            String?     @map("imagem_url")
  quantidadeSolicitada Int         @map("quantidade_solicitada")
  quantidadeProduzida  Int         @default(0) @map("quantidade_produzida")
  tipoCorte            String?     @map("tipo_corte")
  observacao           String?
  statusItem           String      @default("pendente") @map("status_item")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aplicativoId         String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo           Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_itens_solicitacao_producao_aplicativo_id")
  @@map("itens_solicitacao_producao")
}

model PedidoOlistProcessado {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoOlistId         String      @map("pedido_olist_id")
  itemOlistId           String      @map("item_olist_id")
  sku                   String
  solicitacaoProducaoId String      @map("solicitacao_producao_id") @db.Uuid
  turnoId               String?     @map("turno_id") @db.Uuid
  periodoInicio         DateTime?   @map("periodo_inicio") @db.Timestamptz(6)
  periodoFim            DateTime?   @map("periodo_fim") @db.Timestamptz(6)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aplicativoId          String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo            Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([pedidoOlistId, itemOlistId], map: "uq_pedidos_olist_processados_pedido_item")
  @@index([aplicativoId], map: "idx_pedidos_olist_processados_aplicativo_id")
  @@map("pedidos_olist_processados")
}

model MovimentacaoEstoque {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId     String      @map("produto_id") @db.Uuid
  sku           String
  tipoMovimento String      @map("tipo_movimento")
  quantidade    Int
  origem        String
  referenciaId  String?     @map("referencia_id") @db.Uuid
  observacao    String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aplicativoId  String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo    Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_movimentacoes_estoque_aplicativo_id")
  @@map("movimentacoes_estoque")
}

model SolicitacaoDevolucao {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status           String      @default("pendente")
  pedidoReferencia String?     @map("pedido_referencia")
  observacaoGeral  String?     @map("observacao_geral")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmadaEm     DateTime?   @map("confirmada_em") @db.Timestamptz(6)
  aplicativoId     String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo       Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_solicitacoes_devolucao_aplicativo_id")
  @@map("solicitacoes_devolucao")
}

model ItemSolicitacaoDevolucao {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitacaoId        String      @map("solicitacao_id") @db.Uuid
  produtoId            String      @map("produto_id") @db.Uuid
  sku                  String
  imagemUrl            String?     @map("imagem_url")
  quantidadeSolicitada Int         @map("quantidade_solicitada")
  quantidadeConfirmada Int         @default(0) @map("quantidade_confirmada")
  observacao           String?
  statusItem           String      @default("pendente") @map("status_item")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aplicativoId         String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo           Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_itens_solicitacao_devolucao_aplicativo_id")
  @@map("itens_solicitacao_devolucao")
}

model BaixaEstoqueOlist {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  origem       String
  observacao   String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aplicativoId String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo   Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_baixas_estoque_olist_aplicativo_id")
  @@map("baixas_estoque_olist")
}

model ItemBaixaEstoqueOlist {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baixaId        String      @map("baixa_id") @db.Uuid
  produtoId      String?     @map("produto_id") @db.Uuid
  sku            String
  quantidade     Int
  pedidoOlistId  String?     @map("pedido_olist_id")
  itemOlistId    String?     @map("item_olist_id")
  observacao     String?
  origem         String
  movimentacaoId String?     @map("movimentacao_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aplicativoId   String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo     Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([pedidoOlistId, itemOlistId], map: "uq_itens_baixa_olist_pedido_item")
  @@index([aplicativoId], map: "idx_itens_baixa_estoque_olist_aplicativo_id")
  @@map("itens_baixa_estoque_olist")
}

model ControleBuscaOlist {
  chave         String      @id
  ultimaBuscaEm DateTime    @map("ultima_busca_em") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  aplicativoId  String?     @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("aplicativo_id") @db.Uuid
  aplicativo    Aplicativo? @relation(fields: [aplicativoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([aplicativoId], map: "idx_controles_busca_olist_aplicativo_id")
  @@map("controles_busca_olist")
}

model IntegracaoOlistToken {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String     @default("olist")
  accessToken  String?    @map("access_token")
  refreshToken String?    @map("refresh_token")
  expiresAt    DateTime?  @map("expires_at") @db.Timestamptz(6)
  status       String     @default("nao_conectado")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  aplicativoId String     @map("aplicativo_id") @db.Uuid
  aplicativo   Aplicativo @relation(fields: [aplicativoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([aplicativoId, provider], map: "uq_integracao_olist_tokens_aplicativo_provider")
  @@index([aplicativoId], map: "idx_integracao_olist_tokens_aplicativo_id")
  @@map("integracao_olist_tokens")
}

model TipoProduto {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo               String
  sku                  String                         @unique
  descricao            String?
  descricaoSeo         String?                        @map("descricao_seo")
  palavrasChave        String?                        @map("palavras_chave")
  slug                 String?
  categoria            String?
  precoCusto           Decimal?                       @map("preco_custo") @db.Decimal(10, 2)
  preco                Decimal?                       @db.Decimal(10, 2)
  pesoLiquido          Decimal?                       @map("peso_liquido") @db.Decimal(10, 3)
  pesoBruto            Decimal?                       @map("peso_bruto") @db.Decimal(10, 3)
  larguraEmbalagem     Decimal?                       @map("largura_embalagem") @db.Decimal(10, 2)
  alturaEmbalagem      Decimal?                       @map("altura_embalagem") @db.Decimal(10, 2)
  comprimentoEmbalagem Decimal?                       @map("comprimento_embalagem") @db.Decimal(10, 2)
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  detalhesPromptIa     String?                        @map("detalhes_prompt_ia")
  corteLaser           Boolean                        @default(false) @map("corte_laser")
  tecidoCorrido        Boolean                        @default(false) @map("tecido_corrido")
  produtosOlist        ProdutoOlist[]
  produtosFornecedor   TipoProdutoProdutoFornecedor[]

  @@map("tipo_produto")
}

model TipoProdutoProdutoFornecedor {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoProdutoId       String            @map("tipo_produto_id") @db.Uuid
  produtoFornecedorId String            @map("produto_fornecedor_id") @db.Uuid
  quantidadeUsada     Decimal           @map("quantidade_usada") @db.Decimal(10, 4)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  produtoFornecedor   ProdutoFornecedor @relation(fields: [produtoFornecedorId], references: [id], onUpdate: NoAction)
  tipoProduto         TipoProduto       @relation(fields: [tipoProdutoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tipoProdutoId, produtoFornecedorId], map: "uq_tipo_produto_produto_fornecedor")
  @@index([produtoFornecedorId], map: "idx_tipo_produto_produto_fornecedor_produto_id")
  @@map("tipo_produto_produto_fornecedor")
}

model Estampa {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String         @unique
  descricao     String?
  palavrasChave String?        @map("palavras_chave")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  extra         String?
  imagemUrl     String?        @map("imagem_url")
  imagemUrl2    String?        @map("imagem_url_2")
  produtosOlist ProdutoOlist[]
  variantes     Variante[]

  @@map("estampa")
}

model Variante {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String
  descricao     String?
  palavrasChave String?        @map("palavras_chave")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  estampaId     String?        @map("estampa_id") @db.Uuid
  tamanhoId     String?        @map("tamanho_id") @db.Uuid
  produtosOlist ProdutoOlist[]
  estampa       Estampa?       @relation(fields: [estampaId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tamanho       Tamanho?       @relation(fields: [tamanhoId], references: [id], onUpdate: NoAction)

  @@unique([estampaId, codigo], map: "uq_variante_estampa_codigo")
  @@index([estampaId], map: "idx_variante_estampa_id")
  @@index([tamanhoId], map: "idx_variante_tamanho_id")
  @@map("variante")
}

model Tamanho {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo                      String
  sku                         String                     @unique
  slug                        String?                    @unique
  precoCusto                  Decimal?                   @map("preco_custo") @db.Decimal(10, 2)
  preco                       Decimal?                   @db.Decimal(10, 2)
  pesoLiquido                 Decimal?                   @map("peso_liquido") @db.Decimal(10, 3)
  pesoBruto                   Decimal?                   @map("peso_bruto") @db.Decimal(10, 3)
  larguraEmbalagem            Decimal?                   @map("largura_embalagem") @db.Decimal(10, 2)
  alturaEmbalagem             Decimal?                   @map("altura_embalagem") @db.Decimal(10, 2)
  comprimentoEmbalagem        Decimal?                   @map("comprimento_embalagem") @db.Decimal(10, 2)
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  quantidadeProdutoFornecedor Decimal?                   @map("quantidade_produto_fornecedor") @db.Decimal(10, 4)
  produtosOlist               ProdutoOlist[]
  produtosFornecedor          TamanhoProdutoFornecedor[]
  variantes                   Variante[]

  @@map("tamanho")
}

model TamanhoProdutoFornecedor {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tamanhoId           String            @map("tamanho_id") @db.Uuid
  produtoFornecedorId String            @map("produto_fornecedor_id") @db.Uuid
  quantidadeUsada     Decimal           @map("quantidade_usada") @db.Decimal(10, 4)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  produtoFornecedor   ProdutoFornecedor @relation(fields: [produtoFornecedorId], references: [id], onUpdate: NoAction)
  tamanho             Tamanho           @relation(fields: [tamanhoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tamanhoId, produtoFornecedorId], map: "uq_tamanho_produto_fornecedor")
  @@index([produtoFornecedorId], map: "idx_tamanho_produto_fornecedor_produto_id")
  @@map("tamanho_produto_fornecedor")
}

model ProdutoOlist {
  id                   String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoProdutoId        String                          @map("tipo_produto_id") @db.Uuid
  estampaId            String                          @map("estampa_id") @db.Uuid
  varianteId           String?                         @map("variante_id") @db.Uuid
  skuFinal             String                          @unique @map("sku_final")
  tituloFinal          String                          @map("titulo_final")
  descricaoFinal       String?                         @map("descricao_final")
  descricaoSeoFinal    String?                         @map("descricao_seo_final")
  palavrasChaveFinal   String?                         @map("palavras_chave_final")
  slugFinal            String?                         @map("slug_final")
  categoria            String?
  precoCusto           Decimal?                        @map("preco_custo") @db.Decimal(10, 2)
  preco                Decimal?                        @db.Decimal(10, 2)
  pesoLiquido          Decimal?                        @map("peso_liquido") @db.Decimal(10, 3)
  pesoBruto            Decimal?                        @map("peso_bruto") @db.Decimal(10, 3)
  larguraEmbalagem     Decimal?                        @map("largura_embalagem") @db.Decimal(10, 2)
  alturaEmbalagem      Decimal?                        @map("altura_embalagem") @db.Decimal(10, 2)
  comprimentoEmbalagem Decimal?                        @map("comprimento_embalagem") @db.Decimal(10, 2)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tamanhoId            String?                         @map("tamanho_id") @db.Uuid
  produtoId            String?                         @map("produto_id") @db.Uuid
  estampa              Estampa                         @relation(fields: [estampaId], references: [id], onUpdate: NoAction)
  produto              Produto?                        @relation(fields: [produtoId], references: [id], onUpdate: NoAction)
  tamanho              Tamanho?                        @relation(fields: [tamanhoId], references: [id], onUpdate: NoAction)
  tipoProduto          TipoProduto                     @relation(fields: [tipoProdutoId], references: [id], onUpdate: NoAction)
  variante             Variante?                       @relation(fields: [varianteId], references: [id], onUpdate: NoAction)
  produtosFornecedor   ProdutoOlistProdutoFornecedor[]

  @@index([produtoId], map: "idx_produto_olist_produto_id")
  @@index([tipoProdutoId], map: "idx_produto_olist_tipo_produto_id")
  @@index([estampaId], map: "idx_produto_olist_estampa_id")
  @@index([varianteId], map: "idx_produto_olist_variante_id")
  @@index([tamanhoId], map: "idx_produto_olist_tamanho_id")
  @@map("produto_olist")
}

model ProdutoOlistProdutoFornecedor {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoOlistId      String?           @map("produto_olist_id") @db.Uuid
  produtoFornecedorId String            @map("produto_fornecedor_id") @db.Uuid
  quantidadeUsada     Decimal           @map("quantidade_usada") @db.Decimal(10, 4)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  produtoId           String            @unique(map: "uq_produto_olist_produto_fornecedor_produto_id") @map("produto_id") @db.Uuid
  produtoFornecedor   ProdutoFornecedor @relation(fields: [produtoFornecedorId], references: [id], onUpdate: NoAction)
  produto             Produto           @relation(fields: [produtoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produtoOlist        ProdutoOlist?     @relation(fields: [produtoOlistId], references: [id], onUpdate: NoAction)

  @@index([produtoOlistId], map: "idx_produto_olist_produto_fornecedor_produto_olist_id")
  @@index([produtoFornecedorId], map: "idx_produto_olist_produto_fornecedor_produto_id")
  @@map("produto_olist_produto_fornecedor")
}
