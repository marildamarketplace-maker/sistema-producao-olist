generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Produto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku         String   @unique
  nome        String
  imagemUrl   String?  @map("imagem_url")
  metaEstoque Int?     @map("meta_estoque")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("produtos")
}

model ConfiguracaoSistema {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chave     String   @unique
  valor     Decimal  @db.Decimal
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("configuracoes_sistema")
}

model SolicitacaoProducao {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataEntrega     DateTime  @map("data_entrega") @db.Date
  turnoId         String?   @map("turno_id") @db.Uuid
  filtroDataBase  String?   @map("filtro_data_base")
  periodoInicio   DateTime? @map("periodo_inicio") @db.Timestamptz(6)
  periodoFim      DateTime? @map("periodo_fim") @db.Timestamptz(6)
  status          String    @default("pendente")
  observacaoGeral String?   @map("observacao_geral")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("solicitacoes_producao")
}

model ItemSolicitacaoProducao {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitacaoId        String   @map("solicitacao_id") @db.Uuid
  produtoId            String   @map("produto_id") @db.Uuid
  sku                  String
  nome                 String
  imagemUrl            String?  @map("imagem_url")
  quantidadeSolicitada Int      @map("quantidade_solicitada")
  quantidadeProduzida  Int      @default(0) @map("quantidade_produzida")
  tipoCorte            String?  @map("tipo_corte")
  observacao           String?
  statusItem           String   @default("pendente") @map("status_item")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("itens_solicitacao_producao")
}

model PedidoOlistProcessado {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoOlistId         String    @map("pedido_olist_id")
  itemOlistId           String    @map("item_olist_id")
  sku                   String
  solicitacaoProducaoId String    @map("solicitacao_producao_id") @db.Uuid
  turnoId               String?   @map("turno_id") @db.Uuid
  periodoInicio         DateTime? @map("periodo_inicio") @db.Timestamptz(6)
  periodoFim            DateTime? @map("periodo_fim") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([pedidoOlistId, itemOlistId], map: "uq_pedidos_olist_processados_pedido_item")
  @@map("pedidos_olist_processados")
}

model IntegracaoOlistToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String    @unique @default("olist")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  status       String    @default("nao_conectado")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("integracao_olist_tokens")
}
