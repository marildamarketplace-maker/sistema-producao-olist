[Unit]
Description=Trabalhos IA Meury (geracao e revisao)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=operador
WorkingDirectory=/home/operador/sistema-producao-olist
Environment=HOME=/home/operador
EnvironmentFile=/home/operador/.config/meury-worker/trabalhos-ia.env
ExecStart=/usr/bin/node --import tsx scripts/trabalhos-ia-worker.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
